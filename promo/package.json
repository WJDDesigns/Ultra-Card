{
  "name": "ultra-card-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion project for the Ultra Card 30-second teaser video",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render UltraCardTeaser out/ultra-card-teaser.mp4 --codec h264 --crf 18",
    "render:preview": "remotion render UltraCardTeaser out/ultra-card-teaser-preview.mp4 --scale 0.5 --crf 28",
    "still:endcard": "remotion still UltraCardTeaser out/end-card.png --frame 870",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "@remotion/media-utils": "4.0.524",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.524"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
