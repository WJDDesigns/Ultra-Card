exports[`surface goldens > slider_control embossed 1`] = `
[
  ".slider-control-container.uc-slider-layout.uc-layout-overlay.uc-orientation-horizontal {border-radius: 10px; padding: 16px; position: relative;}",
  ".uc-slider-layout.uc-layout-overlay.uc-orientation-horizontal {position: relative;}",
  ".uc-slider-items {display: flex; flex-direction: column; gap: 8px; width: 100%;}",
  "div {position: relative;}",
  ".slider-track-container.uc-slider-track {position: relative; height: 55px; width: 100%; background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color) 0%, rgba(var(--rgb-primary-color), 0.25) 0%, rgba(var(--rgb-primary-color), 0.25) 100%); border-radius: 10px; box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3), inset 0 -2px 4px rgba(255, 255, 255, 0.1), 0 1px 2px rgba(0, 0, 0, 0.2); transition: all 200ms ease; overflow: hidden; --slider-height: 55px;}",
  "div {position: absolute; top: 0; left: 0; height: 100%; width: 0%; background: linear-gradient(to bottom, rgba(255, 255, 255, 0.15) 0%, transparent 40%, rgba(0, 0, 0, 0.15) 100%); border-radius: 10px; pointer-events: none; z-index: 1; transition: width 80ms ease-out, height 80ms ease-out;}",
  ".fill-slider {-webkit-appearance: none; appearance: none; width: 100%; height: 100%; background: transparent; outline: none; cursor: pointer; position: absolute; top: 0; left: 0; z-index: 2;}",
  "div {position: absolute; inset: 0; pointer-events: none; z-index: 3;}",
  "div {position: absolute; left: 8px; top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 8px;}",
  "ha-icon {--mdc-icon-size: 24px; color: var(--primary-text-color); pointer-events: auto; cursor: pointer;}",
  ".uc-slider-name {font-size: 14px; color: var(--primary-text-color); font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 150px;}",
  "div {position: absolute; right: 8px; top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 8px;}",
  ".uc-slider-value {font-size: 14px; color: var(--primary-text-color); font-weight: 600;}",
]
`;

