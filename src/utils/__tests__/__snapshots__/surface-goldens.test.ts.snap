exports[`surface goldens > bar dashed gradient=false sensor.full 1`] = `
[
  ".bar-module-preview {padding: 0; margin: 0; background: transparent; background-image: none; background-size: cover; background-position: center; background-repeat: no-repeat; border: none; border-radius: 10px; position: relative; top: auto; bottom: auto; left: auto; right: auto; z-index: auto; width: 100%; height: 20; max-width: 100%; max-height: none; min-width: 0; min-height: auto; overflow: visible; box-sizing: border-box; clip-path: none; backdrop-filter: none; box-shadow: none; color: var(--primary-text-color); font-family: inherit; font-size: inherit; text-align: inherit; line-height: inherit; letter-spacing: normal; text-shadow: none; display: flex; flex-direction: column}",
  ".bar-flex-wrapper {display: flex; justify-content: center; width: 100%; min-height: 20px; align-items: center; min-width: 0; overflow: visible;}",
  ".bar-container {width: 100%; max-width: 100%; flex: 1 1 0; height: 20px; background: #eeeeee; min-width: 0; border-radius: 10px; overflow: visible; position: relative; transition: all 0.3s ease; border: 1px solid var(--divider-color); ; cursor: default; z-index: 1;}",
  ".bar-fill {width: 100%; height: 100%; background: #2196f3; transition: width 0.3s ease, left 0.3s ease; border-radius: 10px; position: absolute; left: 0; top: 0; bottom: 0; will-change: width; backface-visibility: hidden; mask-image: repeating-linear-gradient( 90deg, black 0px, black 12px, transparent 12px, transparent 16px ); -webkit-mask-image: repeating-linear-gradient( 90deg, black 0px, black 12px, transparent 12px, transparent 16px ); border-radius: 0 10px 10px 0;}",
  ".percentage-text {display: block; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; font-size: 14px; font-weight: 600; font-style: normal; text-decoration: none; z-index: 10; text-shadow: var(--uc-bar-text-shadow, 0 1px 2px rgba(0,0,0,0.5)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; color: var(--uc-bar-text, white);}",
]
`;

